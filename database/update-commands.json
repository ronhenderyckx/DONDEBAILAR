{
  "format_version": 1,
  "project": "DONDEBAILAR",
  "environment": "test",
  "release": "webreus-test-bootstrap",
  "source_ref": "95013fa7324e87966d8518bbc9e4afa0305a84ef",
  "deployment": {
    "strategy": "separate_private_and_public_roots",
    "path_base": "webreus_account_root",
    "targets": {
      "test": {
        "host": "test.dondebailar.eu",
        "private_root": "private/DONDEBAILAR-TEST",
        "public_root": "test"
      },
      "preview": {
        "private_root": "private/DONDEBAILAR-PREVIEW",
        "public_root": "preview"
      },
      "production": {
        "private_root": "private/DONDEBAILAR-PROD",
        "public_root": "web"
      }
    },
    "protected_paths": [
      "config/config.local.php",
      "uploads/",
      "storage/",
      "vendor/"
    ],
    "notes": [
      "Each environment has its own private application files, local configuration, uploads, storage and database settings.",
      "The public_root contains only the contents of the repository public/ directory.",
      "The production target must never be modified by a test or preview update."
    ]
  },
  "steps": [
    {
      "id": "prepare_test_roots",
      "type": "prepare_test_roots",
      "description": "Maakt de private TEST-map en de benodigde applicatiemappen aan. Wijzigt geen publieke bestanden, preview of productie."
    },
    {
      "id": "create_test_private_directories",
      "type": "create_directories",
      "description": "Maakt de private TEST-hoofdmap en alle benodigde submappen aan.",
      "directories": [
        "private/DONDEBAILAR-TEST",
        "private/DONDEBAILAR-TEST/app",
        "private/DONDEBAILAR-TEST/config",
        "private/DONDEBAILAR-TEST/database",
        "private/DONDEBAILAR-TEST/uploads",
        "private/DONDEBAILAR-TEST/storage",
        "private/DONDEBAILAR-TEST/vendor"
      ]
    }
  ]
}
